# MotorSense Environment Configuration

# Database (PostgreSQL)
# For local development with SQLite fallback: sqlite:///./motor_data.db
# For Docker Compose: postgresql+psycopg://motor:motorpass@postgres:5432/motorsense
DATABASE_URL=postgresql+psycopg://motor:motorpass@localhost:5432/motorsense

# API & Security
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:8443,http://localhost:3000,http://motorsense.local
AUTH_ENABLED=false
# Keycloak / OIDC Settings
OIDC_ISSUER=http://localhost:8080/realms/motorsense
OIDC_JWKS_URL=http://localhost:8080/realms/motorsense/protocol/openid-connect/certs
OIDC_AUDIENCE=motorsense-api

# ML & Baseline Models
MODEL_DIR=./models
BASELINE_MIN_SAMPLES=500

# LLM Diagnostics (Hybrid Pipeline)
# Options: 'ollama', 'openrouter', 'none'
LLM_PROVIDER=none
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=

# Ports
BACKEND_PORT=8000
FRONTEND_PORT=5173
KEYCLOAK_PORT=8080
POSTGRES_PORT=5432
